{
  "name": "untangle-api",
  "version": "0.1.0",
  "description": "OpenAI-compatible multi-provider API gateway with routing, control plane features, observability, and a bundled admin UI",
  "type": "module",
  "bin": {
    "untangle-api": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "ui-dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "start": "node ./dist/index.js start",
    "prepack": "pnpm -w run release",
    "prepublishOnly": "pnpm -w run pack:cli:dry-run"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "handlebars": "^4.7.8",
    "hono": "^4.11.10",
    "@hono/node-server": "^1.19.9",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@untangle-ai/core": "workspace:*",
    "@untangle-ai/server": "workspace:*",
    "rimraf": "^6.0.0",
    "tsup": "^8.5.1"
  },
  "keywords": [
    "ai",
    "api",
    "gateway",
    "multi-provider",
    "openai-compatible",
    "proxy",
    "openai",
    "anthropic",
    "gemini",
    "groq",
    "llm",
    "observability",
    "control-plane"
  ],
  "author": "Sai Chaithanya Reddy Yudururi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saichaithanya0705/untangle-api.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/saichaithanya0705/untangle-api/tree/main/packages/cli",
  "bugs": {
    "url": "https://github.com/saichaithanya0705/untangle-api/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
