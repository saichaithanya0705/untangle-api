{
  "name": "@untangle-ai/server",
  "version": "0.1.0",
  "private": true,
  "description": "Internal workspace package for the Untangle API HTTP server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:phase2": "pnpm run test:chaos && pnpm run test:load-profile && pnpm run test:retry-stream && pnpm run test:billing-reconciliation && pnpm run test:release-safety && pnpm run test:soak",
    "test:chaos": "vitest run src/__tests__/chaos-resilience.test.ts",
    "test:load-profile": "vitest run src/__tests__/load-profile.test.ts",
    "test:retry-stream": "vitest run src/__tests__/chat-routing.test.ts src/__tests__/responses.test.ts",
    "test:billing-reconciliation": "vitest run src/__tests__/billing-reconciliation.test.ts",
    "test:release-safety": "vitest run src/__tests__/release-safety.test.ts",
    "test:soak": "vitest run src/__tests__/soak-memory.test.ts",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@untangle-ai/core": "workspace:*",
    "hono": "^4.11.10",
    "@hono/node-server": "^1.19.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "author": "Sai Chaithanya Reddy Yudururi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saichaithanya0705/untangle-api.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/saichaithanya0705/untangle-api/tree/main/packages/server",
  "bugs": {
    "url": "https://github.com/saichaithanya0705/untangle-api/issues"
  }
}
